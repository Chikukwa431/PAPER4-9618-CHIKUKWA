   "source": [
    "def Power(Base, Exp):\n",
    "    if Exp == 0:\n",
    "        return 1\n",
    "    return Base * Power(Base, Exp - 1)\n",
    "\n",
    "def main():\n",
    "    base = 2\n",
    "    exp = 5\n",
    "    result = Power(base, exp)\n",
    "    \n",
    "    print(f\"Base: {base}, Exponent: {exp}\")\n",
    "    print(f\"Result: {result}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  }
 ],
